* {
   /* Global colors */
   white: #efefef;
   outline: #515766;

   bg0: #25252f;
   bg1: #2f2f3b;
   bg2: #3d3d4d;
   fg0: @white;
   fg1: @bg0;

   red: #ff25a5;
   orange: #ffaa00;
   yellow: #efef00;
   green: #00ff7b;
   blue: #71acfc;

   /* Root stylesheet */
   accent: @blue;
   urgent: @orange;

   background-color: transparent;
   font: "FiraCode Nerd Font 12";
   color: @fg0;
}


configuration {
   emoji {
      display-name: "󰞅 ";
   }
}

//@theme "~/.config/rofi/config.rasi"
/* Stylesheet is structured based on the default hierarchy
See:
https://davatorium.github.io/rofi/current/rofi-theme.5/#base-widgets
https://davatorium.github.io/rofi/current/rofi-theme.5/#basic-layout-structure
*/

window {
   location: north;
   y-offset: 65px;
   width: 450px;
   padding: 0 0 0.5em 0;

   border: 1px solid;
   border-color: @outline;
   border-radius: 13px;

   background-color: @bg0;
}

mainbox {
   children: [inputbar, listview];
}

prompt, entry, textbox, element-text, element-icon {
   vertical-align: 0.5;
}

/* inputbar */
inputbar {
   padding: 0.75em 0.85em;
   spacing: 0.85em;

   background-color: @bg1;
   children: [prompt, entry];
}
prompt {
   color: @accent;
}
entry {
   color: @fg0;
}

/* listview */
listview {
   columns: 6;
   lines: 11;
   dynamic: true;
   fixed-height: false;
   fixed-columns: true;
   padding: 0.5em;
   spacing: 0.25em;
   flow: horizontal;
   scrollbar: false; // optional scrollbar
   border: none;
}
scrollbar {
   handle-color: @bg2;
   handle-rounded-corners: true;
}
element {
   padding: 0.35em 0.85em;
   spacing: 0.25em;
}
element normal.normal, element alternate.normal {
   background-color: @bg0;
   color: @fg0;
}
element selected.normal, element selected.active {
   background-color: @accent;
   border-radius: 8px;
   color: @fg1;
}
element-text {
   text-color: inherit;
   horizontal-align: 0.5;
   font: "Segoe UI Emoji 18";
}

/* error-message */
error-message {
   background-color: @bg1;
   padding: 0.3em 0em;
}
