{
	"name": "topbar",
	"layer": "top",
	"modules-left": [
		"niri/workspaces",
		"niri/window",
	],

	"modules-center": [
		"clock",
      "group/hardware"
		//"cpu",
		//"memory",
		//"temperature"
	],

	"modules-right": [
		"tray",
		"pulseaudio",
		"backlight",
		"battery",
		"network",
		"custom/power"
	],
   
	"niri/window": {
		"format": "{app_id}",
      "icon": true,
		"icon-size": 18,
	},
	
	"niri/workspaces": {
		"all-outputs": true
	},

	"clock": {
		"format": " {:%H:%M}",
		"format-alt": "󰃭 {:%a, %d %b %y}",
		"tooltip-format": "󰃰 {:%d-%m-%Y %T}"
	},
   "group/hardware": {
      "orientation": "inherit",
      "drawer": {
         "transition-duration": 250,
         "transition-left-to-right": true,
      },
      "modules": [ "cpu","memory","temperature" ],
   },
	"cpu": {
		"interval": 2,     
		"format": " {usage}%"
	},
	"memory": {
		"interval": 5,
		"format": " {}%",
		"tooltip-format": "RAM: {used:0.1f}GiB — {avail:0.1f}GiB\nSwap: {swapUsed:0.1}GiB — {swapAvail:0.1f}GiB"
	},
	 "temperature": {
    "format": " {temperatureC}°C"
	},

	"tray": {
		"spacing": 12
	},
	"pulseaudio": {
		"format": "{icon}  {volume}%",
		"format-bluetooth": "{icon}  {volume}%",
		"format-muted": "",
		"format-icons": {
			"alsa_output.pci-0000_00_1f.3.analog-stereo": "",
			"alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"phone-muted": "",
			"portable": "",
			"car": "",
			"default": ["", ""]
		},
		"scroll-step": 1,
		"on-click": "pavucontrol",
		"ignored-sinks": ["Easy Effects Sink"]
	},
	"backlight": {
		"device": "intel_backlight",
		"format": "{icon} {percent}%",
		"format-icons": ["", ""]
	},
	"custom/power": {
		"format" : "⏻ ",
		"tooltip": false,
      "on-click": "pgrep wlogout >/dev/null 2>&1 && killall wlogout || wlogout -b 6"
	},
	"battery": {
    "interval": 2,
    "states": {
				"full": 100,
				"normal": 95,
        "warning": 30,
        "critical": 15
    },
    "format": "{icon}  {capacity}%",
		"format-charging": "󱐋 {capacity}%",
    "format-icons": ["", "", "", "", ""],
		"tooltip-format": " {timeTo}\n󱐋 {power}W\n󰗶 {health}%"
	},
	"network": {
		"format": "󰊗  {ifname}",
		"format-wifi": "  {signalStrength}% {essid}",
		"format-ethernet": "󰊗  {ipaddr}/{cidr}",
		"format-disconnected": "󰖪  Disconnected",
		"tooltip-format": "󰊗  {ifname} via {gwaddr} ",
		"tooltip-format-wifi": "  {signalStrength}% {essid}",
		"tooltip-format-ethernet": "  {ifname}",
		"tooltip-format-disconnected": "󰖪  Disconnected",
		"max-length": 20
	}
}
