#!/bin/bash

INPUT_IMG="$1"

if [ -z "$INPUT_IMG" ]; then
    echo "Usage: $0 <image_path>"
    exit 1
fi

awww img --transition-type wipe --transition-duration 1 "$INPUT_IMG" &

TMP_IMG="/tmp/backdrop_unblurred"
BLURRED_IMG="$HOME/.cache/backdrop_blurred"
cp "$INPUT_IMG" "$TMP_IMG"
magick "$TMP_IMG" -resize 25% -blur 0x10 "$BLURRED_IMG"

pgrep wbg &>/dev/null && killall wbg
wbg -s "$BLURRED_IMG" &>/dev/null 2>$1 &

rm "$TMP_IMG"
