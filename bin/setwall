#!/bin/bash

input_img="$1"

if [ -z "$input_img" ]; then
   echo "Usage: $0 <image_path>"
   exit 1
fi

if [[ "$input_img" == *.* ]]; then
   ext=".${input_img##*.}"
else
   ext=""
fi

awww img --transition-type wipe --transition-duration 1 "$input_img" &

tmp_img="/tmp/backdrop_unblurred${ext}" # tmp_img used to prevent corruption on input_img (for some reason?)
blurred_img="$HOME/.cache/backdrop_blurred${ext}"

cp "$input_img" "$tmp_img"
magick "$tmp_img" -resize 25% -blur 0x16 "$blurred_img"

pgrep wbg &>/dev/null && killall wbg
wbg -s "$blurred_img" &>/dev/null &

rm "$tmp_img"
ln -sf "$blurred_img" "$HOME/.cache/backdrop_blurred"
